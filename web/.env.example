DATABASE_URL="file:./dev.db"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
ENABLE_DEBUG_LOGIN="false"
CA_CONNECTOR_KEYS='{"github-oauth-demo-connector":{"keyId":"replace-with-registered-key-id","secret":"replace-with-at-least-32-random-characters"}}'
DEFAULT_CA_CONNECTOR_ID="github-oauth-demo-connector"

# Race problem PDF: development uses process memory only; production relays to Organizer-owned S3/R2/OSS.
ATTACHMENT_STORAGE_DRIVER="memory"
ATTACHMENT_LOCAL_ROOT="C:/ary-private-attachments"
ATTACHMENT_SCANNER="mock-clean"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="10000"
# Keep this JSON in a secret manager, not in Git. Keys are ARY Organizer user IDs.
ORGANIZER_ATTACHMENT_STORES_JSON='{"user_org_1":{"endpoint":"https://s3.example.com","region":"auto","bucket":"organizer-owned-private-bucket","accessKeyId":"replace","secretAccessKey":"replace","prefix":"ary-race-problems","forcePathStyle":false}}'

# Work repository verification: mock is development-only.
GITHUB_REPOSITORY_VERIFIER="mock"
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""
