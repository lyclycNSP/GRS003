generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                    @id
  slug                  String                    @unique
  displayName           String
  githubLogin           String?
  profileCompleted      Boolean                   @default(false)
  rolesJson             String
  city                  String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  authAccounts          AuthAccount[]
  authSessions          AuthSession[]
  registrations         Registration[]
  createdRaces          Race[]                    @relation("RaceCreator")
  judgeAssignments      JudgeAssignment[]         @relation("JudgeAssignments")
  lockedSubmissionRaces Race[]                    @relation("SubmissionLocker")
  submittedWorkVersions WorkSubmissionVersion[]   @relation("WorkVersionSubmitter")
  submissionAuditEvents SubmissionAuditEvent[]    @relation("SubmissionAuditActor")
  createdTeams          Team[]                    @relation("TeamCreator")
  teamMemberships       TeamMember[]
  caConnections         CAConnection[]            @relation("CAConnectionOwner")
  screenControlEvents   ScreenControlAuditEvent[] @relation("ScreenControlActor")
  publishedTrackVersions TrackProfileVersion[]    @relation("TrackVersionPublisher")
}

model AuthSession {
  id         String   @id
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthAccount {
  id                String   @id
  userId            String
  provider          String
  providerAccountId String
  loginName         String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Race {
  id                       String                    @id
  slug                     String                    @unique
  title                    String
  status                   String
  visibility               String
  challenge                String
  summary                  String
  taskId                   String?
  organizerJson            String
  scheduleJson             String
  rulesJson                String
  metricsJson              String
  createdByUserId          String
  createdAt                DateTime                  @default(now())
  archivedAt               DateTime?
  submissionOpensAt        DateTime?
  submissionClosesAt       DateTime?
  submissionLockedAt       DateTime?
  submissionLockedByUserId String?
  submissionLockReason     String?
  createdBy                User                      @relation("RaceCreator", fields: [createdByUserId], references: [id])
  submissionLockedBy       User?                     @relation("SubmissionLocker", fields: [submissionLockedByUserId], references: [id], onDelete: SetNull)
  registrations            Registration[]
  teams                    Team[]
  awards                   Award[]
  reports                  Report[]
  projections              Projection[]
  announcements            Announcement[]
  backups                  Backup[]
  incidents                Incident[]
  releaseItems             ReleaseChecklistItem[]
  screenState              ScreenState?
  submissionAuditEvents    SubmissionAuditEvent[]
  raceRounds               RaceRound[]
  trackProfiles            TrackProfile[]
  screenControlEvents      ScreenControlAuditEvent[]
}

model Team {
  id              String        @id
  raceId          String
  name            String
  slug            String        @unique
  inviteCode      String        @unique
  status          String        @default("draft")
  maxMembers      Int           @default(5)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  race            Race          @relation(fields: [raceId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("TeamCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  registration    Registration?

  @@unique([raceId, name])
}

model TeamMember {
  id       String   @id
  teamId   String
  userId   String
  role     String
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Registration {
  id                    String                 @id
  raceId                String
  userId                String
  participantType       String                 @default("individual")
  teamId                String?                @unique
  status                String
  submittedAt           DateTime
  approvedAt            DateTime?
  race                  Race                   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                  Team?                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  raceProject           RaceProject?
  work                  Work?
  reviewFlags           ReviewFlag[]
  awards                Award[]
  reports               Report[]
  submissionAuditEvents SubmissionAuditEvent[]
  raceRoundEntries      RaceRoundEntry[]

  @@unique([raceId, userId])
}

model RaceProject {
  id                       String         @id
  registrationId           String         @unique
  repoUrl                  String?
  aggregateIngestionStatus String
  connectionHealth         String
  metricsJson              String
  createdAt                DateTime       @default(now())
  lastSyncedAt             DateTime?
  registration             Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  caConnections            CAConnection[]
  reviewFlags              ReviewFlag[]
}

model TrackProfile {
  id        String                @id
  trackId   String                @unique
  raceId    String?
  name      String
  scope     String                @default("system")
  createdAt DateTime              @default(now())
  race      Race?                 @relation(fields: [raceId], references: [id], onDelete: Cascade)
  versions  TrackProfileVersion[]

  @@index([raceId])
}

model TrackProfileVersion {
  id                 String       @id
  trackId            String
  version            String
  status             String
  schemaVersion      String
  profileJson        String
  checksum           String
  backgroundAssetRef String
  publishRequestId   String?      @unique
  profileHash        String?
  backgroundHash     String?
  validationReportJson String?
  publishedByUserId  String?
  createdAt          DateTime     @default(now())
  publishedAt        DateTime?
  track              TrackProfile @relation(fields: [trackId], references: [trackId], onDelete: Cascade)
  publishedBy        User?         @relation("TrackVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  raceRounds         RaceRound[]

  @@unique([trackId, version])
  @@index([status])
  @@index([publishedByUserId])
}

model RaceRound {
  id                    String              @id
  raceId                String
  trackProfileVersionId String
  name                  String
  order                 Int
  status                String
  scheduledStartAt      DateTime
  scheduledEndAt        DateTime
  actualStartedAt       DateTime?
  actualEndedAt         DateTime?
  createdAt             DateTime            @default(now())
  race                  Race                @relation(fields: [raceId], references: [id], onDelete: Cascade)
  trackProfileVersion   TrackProfileVersion @relation(fields: [trackProfileVersionId], references: [id])
  entries               RaceRoundEntry[]
  screenStates          ScreenState[]

  @@unique([raceId, order])
  @@index([trackProfileVersionId])
}

model RaceRoundEntry {
  id             String       @id
  raceRoundId    String
  registrationId String
  displayOrder   Int
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  raceRound      RaceRound    @relation(fields: [raceRoundId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([raceRoundId, registrationId])
  @@unique([raceRoundId, displayOrder])
  @@index([registrationId])
}

model CAConnection {
  id                 String               @id
  raceProjectId      String
  ownerUserId        String?
  caType             String
  connectorId        String
  connectorVersion   String
  signingKeyId       String
  externalProjectRef String
  ingestionStatus    String
  registeredAt       DateTime
  handshakeAt        DateTime?
  disabledAt         DateTime?
  lastSyncedAt       DateTime?
  raceProject        RaceProject          @relation(fields: [raceProjectId], references: [id], onDelete: Cascade)
  owner              User?                @relation("CAConnectionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sessions           Session[]
  ingestionReceipts  CAIngestionReceipt[]

  @@unique([raceProjectId, connectorId, externalProjectRef])
}

model CAIngestionReceipt {
  id             String       @id
  caConnectionId String
  messageId      String
  idempotencyKey String
  payloadHash    String
  signedAt       DateTime
  receivedAt     DateTime     @default(now())
  caConnection   CAConnection @relation(fields: [caConnectionId], references: [id], onDelete: Cascade)

  @@unique([caConnectionId, messageId])
  @@unique([caConnectionId, idempotencyKey])
  @@index([receivedAt])
}

model Session {
  id                 String       @id
  caConnectionId     String
  externalSessionRef String
  startedAt          DateTime?
  endedAt            DateTime?
  lastActiveAt       DateTime?
  messageCount       Int          @default(0)
  toolCallCount      Int          @default(0)
  tokens             Int          @default(0)
  snapshotJson       String
  caConnection       CAConnection @relation(fields: [caConnectionId], references: [id], onDelete: Cascade)

  @@unique([caConnectionId, externalSessionRef])
}

model Work {
  id                    String                  @id
  registrationId        String                  @unique
  slug                  String                  @unique
  title                 String
  summary               String
  status                String
  visibility            String
  demoUrl               String?
  repoUrl               String?
  submittedAt           DateTime?
  publishedAt           DateTime?
  currentVersionId      String?                 @unique
  versionCounter        Int                     @default(0)
  registration          Registration            @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  currentVersion        WorkSubmissionVersion?  @relation("CurrentWorkVersion", fields: [id, currentVersionId], references: [workId, id], onDelete: NoAction)
  submissionVersions    WorkSubmissionVersion[] @relation("WorkVersions")
  submissionAuditEvents SubmissionAuditEvent[]
  evidences             Evidence[]
  reviewFlags           ReviewFlag[]
  assignments           JudgeAssignment[]
  awards                Award[]

  @@unique([id, currentVersionId])
}

model WorkSubmissionVersion {
  id                    String                 @id
  workId                String
  versionNumber         Int
  title                 String
  summary               String
  demoUrl               String?
  repoUrl               String
  repoCommitSha         String
  hashSchemaVersion     String
  integrityHash         String
  submittedByUserId     String
  submittedAt           DateTime
  work                  Work                   @relation("WorkVersions", fields: [workId], references: [id], onDelete: Cascade)
  currentForWork        Work?                  @relation("CurrentWorkVersion")
  submittedBy           User                   @relation("WorkVersionSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  judgeAssignments      JudgeAssignment[]
  awards                Award[]
  submissionAuditEvents SubmissionAuditEvent[]

  @@unique([workId, versionNumber])
  @@unique([workId, id])
  @@index([integrityHash])
  @@index([submittedAt])
}

model SubmissionAuditEvent {
  id                      String                 @id
  raceId                  String
  registrationId          String?
  workId                  String?
  workSubmissionVersionId String?
  actorUserId             String
  action                  String
  reason                  String?
  metadataJson            String
  createdAt               DateTime               @default(now())
  race                    Race                   @relation(fields: [raceId], references: [id], onDelete: Restrict)
  registration            Registration?          @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  work                    Work?                  @relation(fields: [workId], references: [id], onDelete: Restrict)
  workSubmissionVersion   WorkSubmissionVersion? @relation(fields: [workId, workSubmissionVersionId], references: [workId, id], onDelete: Restrict)
  actor                   User                   @relation("SubmissionAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([raceId, createdAt])
  @@index([workId, createdAt])
}

model Evidence {
  id             String   @id
  raceId         String
  registrationId String
  workId         String?
  type           String
  title          String
  summary        String
  sourceRefJson  String
  visibility     String
  createdAt      DateTime @default(now())
  work           Work?    @relation(fields: [workId], references: [id], onDelete: SetNull)
}

model ReviewFlag {
  id                  String       @id
  raceId              String
  registrationId      String
  raceProjectId       String?
  workId              String?
  type                String
  severity            String
  status              String
  judgeVisibleSummary String
  resolutionNote      String?
  resolvedByUserId    String?
  sourceRefJson       String
  createdAt           DateTime     @default(now())
  resolvedAt          DateTime?
  updatedAt           DateTime     @updatedAt
  registration        Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  raceProject         RaceProject? @relation(fields: [raceProjectId], references: [id], onDelete: SetNull)
  work                Work?        @relation(fields: [workId], references: [id], onDelete: SetNull)
}

model JudgeAssignment {
  id                      String                 @id
  raceId                  String
  workId                  String
  judgeUserId             String
  assignedByUserId        String
  status                  String
  assignedAt              DateTime
  workSubmissionVersionId String?
  work                    Work                   @relation(fields: [workId], references: [id], onDelete: Cascade)
  workSubmissionVersion   WorkSubmissionVersion? @relation(fields: [workId, workSubmissionVersionId], references: [workId, id], onDelete: Restrict)
  judge                   User                   @relation("JudgeAssignments", fields: [judgeUserId], references: [id], onDelete: Cascade)
  judgingRecord           JudgingRecord?

  @@unique([workId, judgeUserId])
}

model JudgingRecord {
  id           String          @id
  assignmentId String          @unique
  scoreResult  Int
  scoreRiding  Int
  comments     String
  status       String
  submittedAt  DateTime?
  assignment   JudgeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model Award {
  id                      String                 @id
  raceId                  String
  registrationId          String
  workId                  String?
  awardName               String
  rank                    Int
  decisionReason          String
  status                  String
  publishedAt             DateTime?
  workSubmissionVersionId String?
  race                    Race                   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  registration            Registration           @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  work                    Work?                  @relation(fields: [workId], references: [id], onDelete: SetNull)
  workSubmissionVersion   WorkSubmissionVersion? @relation(fields: [workId, workSubmissionVersionId], references: [workId, id], onDelete: Restrict)

  @@unique([raceId, awardName, rank])
  @@unique([raceId, awardName, registrationId])
}

model Report {
  id                    String        @id
  raceId                String
  type                  String
  subjectRegistrationId String?
  status                String
  visibility            String
  content               String
  generatedAt           DateTime?
  publishedAt           DateTime?
  lastError             String?
  race                  Race          @relation(fields: [raceId], references: [id], onDelete: Cascade)
  subjectRegistration   Registration? @relation(fields: [subjectRegistrationId], references: [id], onDelete: SetNull)
}

model Projection {
  id              String        @id
  raceId          String
  type            String
  status          String
  payloadJson     String
  stableVersionId String?
  lastRebuiltAt   DateTime
  schemaVersion   String?
  sequence        Int?
  generatedAt     DateTime?
  sourceWatermark String?
  payloadHash     String?
  race            Race          @relation(fields: [raceId], references: [id], onDelete: Cascade)
  screenStates    ScreenState[]

  @@unique([raceId, type, sequence])
}

model Announcement {
  id          String    @id
  raceId      String
  title       String
  body        String
  visibility  String
  publishedAt DateTime?
  race        Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)
}

model ScreenState {
  id                      String                    @id
  raceId                  String                    @unique
  mode                    String
  fallbackEnabled         Boolean                   @default(false)
  currentRoundId          String?
  stableProjectionId      String?
  activeGroupOrder        Int                       @default(1)
  autoRotateEnabled       Boolean                   @default(true)
  rotationIntervalSeconds Int                       @default(15)
  rotationEpochAt         DateTime                  @default(now())
  rotationPausedAt        DateTime?
  controlVersion          Int                       @default(0)
  updatedAt               DateTime                  @updatedAt
  race                    Race                      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  currentRound            RaceRound?                @relation(fields: [currentRoundId], references: [id], onDelete: SetNull)
  stableProjection        Projection?               @relation(fields: [stableProjectionId], references: [id], onDelete: SetNull)
  controlEvents           ScreenControlAuditEvent[]

  @@index([currentRoundId])
  @@index([stableProjectionId])
}

model ScreenControlAuditEvent {
  id            String       @id
  raceId        String
  screenStateId String?
  actorUserId   String
  action        String
  reason        String?
  payloadJson   String
  createdAt     DateTime     @default(now())
  race          Race         @relation(fields: [raceId], references: [id], onDelete: Cascade)
  screenState   ScreenState? @relation(fields: [screenStateId], references: [id], onDelete: SetNull)
  actor         User         @relation("ScreenControlActor", fields: [actorUserId], references: [id])

  @@index([raceId, createdAt])
  @@index([actorUserId])
}

model Backup {
  id        String   @id
  raceId    String
  scope     String
  status    String
  evidence  String
  createdAt DateTime @default(now())
  race      Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
}

model Incident {
  id                String   @id
  raceId            String
  occurredAt        DateTime
  impact            String
  affectedRolesJson String
  action            String
  fallbackTriggered Boolean
  rollback          Boolean
  followUp          String
  race              Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
}

model ReleaseChecklistItem {
  id        String    @id
  raceId    String
  itemKey   String
  label     String
  status    String
  evidence  String
  updatedAt DateTime?
  race      Race      @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, itemKey])
}
